<Window x:Class="WindowFloatIA.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WindowFloatIA" Width="560" MinWidth="360" SizeToContent="Height"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
 Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
 Foreground="#EEEEEE" FontFamily="Segoe UI" FontSize="13"
 PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing" AllowDrop="True"
 PreviewDragOver="OnDragOver" PreviewDrop="OnDrop">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="28"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#484848"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#484848"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="Shell" Margin="12" Background="#262626" BorderBrush="#393939" BorderThickness="1" CornerRadius="26" Padding="16,5,16,10">
  <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4"/></Border.Effect>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Background="Transparent" MouseLeftButtonDown="OnDragWindow">
    <TextBlock x:Name="StatusText" Text="Configure o GPT para começar" MaxWidth="210" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" Foreground="#999999" FontSize="10" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="HistoryButton" Content="⌃" ToolTip="Expandir ou recolher conversa" AutomationProperties.Name="Alternar conversa" Click="OnToggleHistory"/>
     <Button Content="×" FontSize="20" ToolTip="Esconder (Esc)" AutomationProperties.Name="Esconder janela" Click="OnHideClick"/>
    </StackPanel>
   </Grid>
   <Grid x:Name="HistoryPanel" Grid.Row="1" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="8"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,8">
     <ItemsControl ItemsSource="{Binding Messages}">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="{Binding Background}" CornerRadius="12" Padding="12" Margin="0,0,5,10">
        <StackPanel><TextBlock Text="{Binding Author}" Foreground="#AFA7FF" FontWeight="SemiBold" FontSize="11"/>
         <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <Thumb Grid.Row="1" Cursor="SizeNS" DragDelta="OnHistoryResize" ToolTip="Ajustar altura da conversa">
     <Thumb.Template><ControlTemplate><Border Background="Transparent"><Border Height="2" Width="36" Background="#555555" CornerRadius="1"/></Border></ControlTemplate></Thumb.Template>
    </Thumb>
   </Grid>
   <Grid Grid.Row="2" Margin="0,5,0,6">
    <TextBox x:Name="Composer" Background="Transparent" Foreground="#EEEEEE" CaretBrush="White"
     BorderThickness="0" Padding="0" MinHeight="30" MaxHeight="120" AcceptsReturn="True"
     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnTextChanged"
     AutomationProperties.Name="Mensagem"/>
    <TextBlock x:Name="Placeholder" Text="Pergunte ao GPT…" Foreground="#BDBDBD"
     IsHitTestVisible="False" Margin="2,2,0,0" TextWrapping="Wrap"/>
   </Grid>
   <ScrollViewer Grid.Row="3" MaxHeight="76" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding Attachments}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="#383838" CornerRadius="8" Margin="0,0,6,6" Padding="6,0">
       <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Path}"/>
        <Button Content="×" Tag="{Binding}" Click="OnRemoveAttachment" AutomationProperties.Name="Remover anexo"/>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <Grid Grid.Row="4">
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="✦" Foreground="#AAA0FF" FontSize="23" VerticalAlignment="Center" Margin="2,0,10,0"/>
     <Button Content="+" FontSize="23" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Anexos estarão disponíveis em uma próxima versão" AutomationProperties.Name="Anexos indisponíveis"/>
     <Button x:Name="SettingsButton" Content="GPT" ToolTip="Entrar com ChatGPT e escolher modelo" Click="OnSettings"/>
     <Button x:Name="NewChatButton" Content="Novo" ToolTip="Limpar conversa e contexto" Click="OnNewChat"/>
     <CheckBox Content="Fixar" IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="Manter acima das outras janelas"/>
    </StackPanel>
    <Button x:Name="SendButton" Content="↑" FontSize="20" HorizontalAlignment="Right" Background="#6257A6"
     Width="34" IsEnabled="False" ToolTip="Enviar (Enter)" AutomationProperties.Name="Enviar mensagem" Click="OnSend"/>
   </Grid>
   <Thumb Grid.RowSpan="5" Width="6" HorizontalAlignment="Right" Margin="0,25,-13,12" Cursor="SizeWE" DragDelta="OnWidthResize">
    <Thumb.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
   </Thumb>
  </Grid>
 </Border>
</Window>
