<Window x:Class="WindowFloatIA.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WindowFloatIA" Width="620" Height="240" MinWidth="420" MinHeight="230"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
 Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
 Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
 PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
 <Window.Resources>
 <ResourceDictionary>
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Controls.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="28"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ResizeHandle" TargetType="Thumb">
   <Setter Property="Template"><Setter.Value><ControlTemplate><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
   <EventSetter Event="DragDelta" Handler="OnResize"/>
   <EventSetter Event="DragCompleted" Handler="OnResizeCompleted"/>
  </Style>
 </ResourceDictionary>
 </Window.Resources>
 <Grid>
 <Border x:Name="Shell" Margin="12" Background="{DynamicResource ShellBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="24" Padding="16,8,16,12">
  <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4"/></Border.Effect>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Grid Background="Transparent" MouseLeftButtonDown="OnDragWindow">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Selected.Status}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Button Grid.Column="1" x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" ToolTip="Configurações: contas, agentes e aparência" AutomationProperties.Name="Configurações" Click="OnSettings"/>
    <Button Grid.Column="2" x:Name="HistoryButton" Content="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" ToolTip="Expandir ou recolher conversa" AutomationProperties.Name="Alternar conversa" Click="OnToggleHistory"/>
    <Button Grid.Column="3" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" ToolTip="Esconder (Esc)" AutomationProperties.Name="Esconder janela" Click="OnHideClick"/>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ListBox x:Name="TabList" ItemsSource="{Binding Tabs}" SelectionChanged="OnTabSelection"
     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
     <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
       <Border x:Name="TabSurface" CornerRadius="8" Padding="6,1" Background="{DynamicResource SurfaceBrush}"><ContentPresenter/></Border>
       <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
     </Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="{Binding Indicator}" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
       <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" MaxWidth="145" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}"/>
       <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Tag="{Binding}" Click="OnCloseTab" ToolTip="Fechar conversa" AutomationProperties.Name="Fechar conversa" Padding="6,0"/>
      </StackPanel>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Button Grid.Column="1" x:Name="NewChatButton" Content="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" AutomationProperties.Name="Nova conversa" Width="36" ToolTip="Abrir nova conversa" Click="OnNewChat"/>
   </Grid>
   <Grid x:Name="HistoryPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,6,0,8">
    <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
     ScrollChanged="OnHistoryScrollChanged" PreviewMouseWheel="OnHistoryWheel">
     <ItemsControl x:Name="MessageList" ItemsSource="{Binding Selected.Messages}">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="12" Margin="0,0,5,10">
        <StackPanel><TextBlock Text="{Binding Author}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <Button x:Name="JumpButton" Content="↓ Ir para o final" ToolTip="Retomar acompanhamento da resposta" Background="{DynamicResource SelectedBrush}" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,20,8" Click="OnJumpToEnd"/>
   </Grid>
   <Grid Grid.Row="3" Margin="0,6,0,8" MinHeight="36" MaxHeight="120">
    <TextBox x:Name="Composer" Background="Transparent" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
     BorderThickness="0" Padding="0" MinHeight="36" MaxHeight="120" AcceptsReturn="True"
     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnTextChanged" AutomationProperties.Name="Mensagem"/>
    <TextBlock x:Name="Placeholder" Text="Pergunte ao GPT…" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" Margin="2,2,0,0"/>
   </Grid>
   <Grid Grid.Row="4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="&#xE99A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="Agente ChatGPT" Foreground="{DynamicResource AccentTextBrush}" FontSize="19" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <ComboBox x:Name="ModelPicker" Grid.Column="1" MaxWidth="260" MinWidth="100" HorizontalAlignment="Left" VerticalAlignment="Center"
     DisplayMemberPath="DisplayName" SelectedValuePath="Slug" SelectionChanged="OnModelSelection" ToolTip="Modelo desta conversa" AutomationProperties.Name="Modelo GPT"/>

    <Button Grid.Column="3" x:Name="SendButton" Content="&#xE724;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Background="{DynamicResource AccentBrush}" Width="34" IsEnabled="False" ToolTip="Enviar (Enter)" AutomationProperties.Name="Enviar mensagem" Click="OnSend"/>
   </Grid>
  </Grid>
 </Border>
 <Thumb Style="{StaticResource ResizeHandle}" Tag="L" Cursor="SizeWE" Width="8" HorizontalAlignment="Left" Margin="9,28,0,28"/>
 <Thumb Style="{StaticResource ResizeHandle}" Tag="R" Cursor="SizeWE" Width="8" HorizontalAlignment="Right" Margin="0,28,9,28"/>
 <Thumb Style="{StaticResource ResizeHandle}" Tag="T" Cursor="SizeNS" Height="8" VerticalAlignment="Top" Margin="28,9,28,0"/>
 <Thumb Style="{StaticResource ResizeHandle}" Tag="B" Cursor="SizeNS" Height="8" VerticalAlignment="Bottom" Margin="28,0,28,9"/>
 <Thumb Style="{StaticResource ResizeHandle}" Tag="LT" Cursor="SizeNWSE" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9"/>
 <Thumb Style="{StaticResource ResizeHandle}" Tag="RT" Cursor="SizeNESW" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9"/>
 <Thumb Style="{StaticResource ResizeHandle}" Tag="LB" Cursor="SizeNESW" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9"/>
 <Thumb Style="{StaticResource ResizeHandle}" Tag="RB" Cursor="SizeNWSE" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="9"/>
 </Grid>
</Window>
