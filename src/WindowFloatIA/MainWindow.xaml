<Window x:Class="WindowFloatIA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowFloatIA" Width="440" Height="520" MinWidth="360" MinHeight="400"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        Background="#111827" Foreground="#F3F4F6"
        PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="WindowFloatIA" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Seu espaço flutuante" Foreground="#9CA3AF" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#1F2937" CornerRadius="12" Padding="20" Margin="0,24,0,24">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Pronto quando você precisar" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="Use Ctrl + Alt + Espaço para mostrar ou esconder esta janela, mesmo enquanto usa outro aplicativo."
                           Foreground="#D1D5DB" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="14"/>
                <TextBlock Text="Esta é a base do aplicativo. A integração com IA será adicionada depois."
                           Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2">
            <CheckBox Content="Manter acima das outras janelas" Foreground="#F3F4F6"
                      IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="Esconder janela" Click="OnHideClick" Padding="12,10" Margin="0,16,0,0"
                    Background="#A5B4FC" Foreground="#111827" BorderThickness="0"/>
            <TextBlock Text="Esc esconde · Para encerrar, use Sair na bandeja"
                       FontSize="11" Foreground="#9CA3AF" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
